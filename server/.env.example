# Public URL of this deployed app (no trailing slash)
BASE_URL=http://localhost:3000

# Storage backend for the relay's single-use session store:
# "postgres" (prod; requires DATABASE_URL) or "memory" (local/tests, in-process).
KV_BACKEND=memory

# Google OAuth 2.0 authorization endpoint
GOOGLE_AUTH_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth

# Session/entry TTL in seconds (~10 minutes)
SESSION_TTL_SECONDS=600

# Server port (Render provides PORT automatically)
PORT=3000

# Postgres connection string. Required when KV_BACKEND=postgres; also used by
# Sequelize at runtime and by `npm run migrate` (sequelize-cli). With
# KV_BACKEND=memory the relay boots without it.
# DATABASE_URL=postgres://postgres:pass@localhost:5432/margedev

# Secret used to verify HS256 JWTs on /v1 protected routes.
# In production this is read from the Render `production` env group; an unset
# secret safely yields 401. Set a local value here only if you need it.
# JWT_SECRET=

# Google OAuth web client used by the marge website's "Sign in with Google".
# Both must be set for POST /v1/auth/google/signin to work; without them the
# relay still boots and sign-in answers 500. Not needed locally if you use
# dev sign-in (/dev-user) instead.
# GOOGLE_SIGNIN_CLIENT_ID=
# GOOGLE_SIGNIN_CLIENT_SECRET=

# Comma-separated emails allowed to sign in (compared case-insensitively).
# Empty or unset means nobody can sign in with Google.
# MARGE_ALLOWED_EMAILS=

# Comma-separated browser origins allowed to call /v1 (CORS).
CLIENT_ORIGINS=http://localhost:5173

# Turns on dev sign-in (POST /v1/auth/dev-login, used by the client's /dev-user). Never set this on Render.
NODE_ENV=development
